# ============================================================
# PLM 物料治理 + 录入助手 —— 环境变量模板
# 用法：复制成 .env 后按实际环境填写（.env 已被 .gitignore 忽略，不会入库）
#   cp .env.example .env
# 优先级：进程真实环境变量（PM2/docker/systemd 注入） > 本文件 > 代码默认值
# ============================================================

# ---------------- 数据库（金蝶 ERP / SQL Server） ----------------
# 缺任意一项，涉及数据库的功能（extract / 看板 ERP 查询）会直接报
#   [db] 缺少必需环境变量 XXX，请在 .env 中配置
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
# 是否启用 TLS 加密连接。内网自签证书环境一般填 false
DB_ENCRYPT=false

# ---------------- 服务端口（统一在此管理） ----------------
# 治理看板（src/server.js）监听端口
PORT=3000
# 仅监听 IPv4 时填 0.0.0.0；留空则用 Node 默认（监听所有网卡，含 IPv6）
WEB_HOST=
# 端口被占用时是否自动 +1。默认 false：端口由本文件唯一决定，
# 避免 PM2 下端口静默漂移导致反代/防火墙规则失效。
PORT_AUTO_INCREMENT=false

# PLM 接口（src/plm-server.js）监听端口。
# 改这里必须同步修改 PLM 侧 ItemSmartInput.js 的 CFG.apiBase
PLM_API_PORT=3100
# 0.0.0.0 = 允许局域网其他电脑访问；127.0.0.1 = 仅本机
PLM_API_HOST=0.0.0.0

# ---------------- 大模型（可选，仅「AI 辅助提取」用） ----------------
# 设为 1 才启用 AI 叠加提取，默认关闭
AI_EXTRACT=0
# cloud = MiniMax（走 MINIMAX_*）；local = 内部 Qwen（走 AI_LOCAL_*）
AI_DEFAULT_PROFILE=cloud
AI_LOCAL_BASE_URL=http://localhost:8080/v1
AI_LOCAL_API_KEY=
AI_LOCAL_MODEL=
MINIMAX_API_URL=
MINIMAX_API_KEY=
TOKENHUB_MODEL=MiniMax-M2.5-highspeed

# ---------------- 数据快照与缓存（可选，一般保持默认） ----------------
# data/ 下的文件超过多少天视为可疑，需要刷新
SNAPSHOT_STALE_DAYS=1
# 探测 ERP 连通性超时(ms)
SNAPSHOT_PING_TIMEOUT=8000
# 设为 1 时后台自动刷新快照
AUTO_REFRESH_SNAPSHOT=0
# 后台检查快照的间隔(分钟)
SNAPSHOT_CHECK_MINUTES=60

# 库存/项目号缓存有效期(ms)，默认 30 分钟
INV_CACHE_TTL=1800000
# 单条交互式 ERP 查询超时(ms)
INV_QUERY_TIMEOUT=10000
