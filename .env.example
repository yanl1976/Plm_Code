# ============================================================
# PLM 物料治理 + 录入助手 —— 环境变量模板
# 用法：复制成 .env 后按实际环境填写
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库；本模板可入库。
#
# 加载点：src/env.js（全项目唯一，两个服务共用）
# 优先级：进程真实环境变量（PM2 / docker / systemd 注入） > 本文件 > 代码默认值
# 启动日志会打印实际来源，如：[plm-api] 已加载 /opt/Plm_Code/.env（注入 68 项）
#
# 说明：本文件只列本项目实际读取的变量。同机其他系统（Vite 前端、邮件通知、
# Prisma 影子库等）的变量请勿混入，避免误配与密钥扩散。
# ============================================================

# ---------------- 数据库（金蝶 ERP / SQL Server） ----------------
# 缺任意必填项时报错：[db] 缺少必需环境变量 XXX，请在 .env 中配置
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
# 内网自签证书环境一般填 false；填 true 时走 TLS 加密
DB_ENCRYPT=false

# ---------------- 服务端口（两个服务分开管理） ----------------
# ① 治理看板 src/server.js（人工操作：提取/查重/映射/ERP 查询）
# 与 .env 实际值保持一致（当前 3130；代码兜底默认 3000）
PORT=3130
# 仅监听 IPv4 时填 0.0.0.0；留空 = Node 默认（所有网卡，含 IPv6）
WEB_HOST=
# 端口被占用时是否自动 +1。默认 false：端口由本文件唯一决定，避免 PM2 下静默漂移
PORT_AUTO_INCREMENT=false

# ② PLM 接口 src/plm-server.js（被 PLM 页面里的浏览器 JS 调用）
# 改端口必须同步修改 PLM 侧 ItemSmartInput.js 的 CFG.apiBase
PLM_API_PORT=3100
# 0.0.0.0 = 允许局域网访问（PLM 必需）；127.0.0.1 = 仅本机
PLM_API_HOST=0.0.0.0
# 对外公布地址：启动日志的「局域网」行与 /api/plm/health 的 listen.apiBase 都用它。
# 多网卡机器务必指定，否则会不知道该填哪个地址。
# 例：生产机 PLM_LAN_IP=192.168.20.31；留空 = 自动挑选内网优先级最高的网卡
#     （优先级 192.168.x > 198.168.x > 10.x > 172.16-31.x，11.x 等宽带网卡不会被选中）
PLM_LAN_IP=

# ---------------- 大模型（可选，仅「AI 辅助提取」启用时才读取） ----------------
# 1=启用 AI 叠加提取；0/留空=纯规则提取（默认关闭，不影响主流程）
AI_EXTRACT=0
# 默认档案：local（内部大模型）| cloud（外部模型 API）
AI_DEFAULT_PROFILE=cloud

# ---- local 档案：内部大模型（OpenAI 兼容接口） ----
AI_LOCAL_BASE_URL=http://localhost:8080/v1
AI_LOCAL_API_KEY=
AI_LOCAL_MODEL=

# ---- cloud 档案：外部模型 API（两套命名任选其一，MINIMAX_* 优先） ----
# 推荐 TOKENHUB_*：填 /v1 基址，代码自动拼 /chat/completions
TOKENHUB_BASE_URL=
TOKENHUB_API_KEY=
TOKENHUB_MODEL=MiniMax-M2.5-highspeed
# 兼容旧命名：MINIMAX_API_URL 需填完整路径（含 /chat/completions）
MINIMAX_API_URL=
MINIMAX_API_KEY=

# ---------------- 数据快照与缓存（可选，一般保持默认） ----------------
# data/ 下产物超过多少天视为可疑、需刷新
SNAPSHOT_STALE_DAYS=1
# 探测 ERP 连通性超时(ms)
SNAPSHOT_PING_TIMEOUT=8000
# 1=后台自动刷新快照
AUTO_REFRESH_SNAPSHOT=0
# 后台检查快照的间隔(分钟)
SNAPSHOT_CHECK_MINUTES=60
# 库存/项目号缓存有效期(ms)，默认 30 分钟
INV_CACHE_TTL=1800000
# 单条交互式 ERP 查询超时(ms)
INV_QUERY_TIMEOUT=10000
