{
  "_comment": "型号编码解码表：当 spec-fields.json 的正则文本提取为空的「盲区」，按品牌特征前缀识别型号编码，解出额定电流/线圈电压等。规则：仅当文本提取为空时才解码（fill-when-empty），未知编码不解码，绝不覆盖已提取的文本值。table 仅含高置信编码。",
  "decoders": [
    {
      "id": "schneider_lc1",
      "detect": "LC1[-—]?[DFBENG]",
      "rules": [
        {
          "param": "额定电流",
          "regex": "(?:LC1[-—]?[DFBENG]\\s*)(\\d+)",
          "table": {
            "06": "6", "09": "9", "12": "12", "18": "18", "25": "25", "32": "32",
            "38": "38", "40": "40", "50": "50", "65": "65", "80": "80", "95": "95",
            "115": "115", "150": "150", "170": "170", "205": "205", "245": "245",
            "300": "300", "410": "410", "475": "475", "620": "620"
          },
          "stripZeros": true
        },
        {
          "param": "线圈电压",
          "regex": "(?:LC1[-—]?[DFBENG]\\s*\\d+\\s*)([A-Z])(\\d)",
          "table": {
            "M7": "AC220V", "C7": "AC220V", "B7": "AC24V", "D7": "AC110V",
            "E7": "AC380V", "F7": "AC110V", "G7": "AC120V", "K7": "DC24V",
            "N7": "DC220V", "P7": "DC24V",
            "Q7": "AC380V", "V7": "AC400V", "U7": "DC48V", "W7": "DC48V"
          },
          "_note": "M7 已用本库数据校准；Q7/V7/U7/W7 取自施耐德标准线圈码表，本库无显式样本，待核对"
        }
      ]
    },
    {
      "id": "schneider_lrd",
      "detect": "LRD",
      "rules": [
        {
          "param": "额定电流",
          "regex": "(?:LRD[-]?)(\\d+)",
          "table": {
            "01": "0.10-0.16", "02": "0.16-0.25", "03": "0.25-0.40", "04": "0.40-0.63",
            "05": "0.63-1", "06": "1-1.6", "07": "1.6-2.5", "08": "2.5-4", "09": "4-6",
            "10": "6-10", "11": "9-13", "12": "12-18", "13": "17-23", "14": "7-10",
            "15": "9-13", "16": "9-13", "21": "12-18", "22": "16-24", "25": "17-25",
            "32": "23-32", "38": "30-38", "93": "37-50", "100": "63-80", "105": "45-65",
            "160": "110-160", "200": "125-200", "365": "500-650"
          },
          "_note": "标准施耐德 LRD 热继电流范围；部分区间(如14=7-10A)依据本库样本校准，建议对照目录复核"
        }
      ]
    },
    {
      "id": "chint_contactor",
      "detect": "GSC1|GSC2|GSC3|CJX1|CJX2|CJX4|NXC|NXRC|NDC1|BJ2|HC1|CCZ38|CZ28",
      "rules": [
        {
          "param": "额定电流",
          "regex": "(?:GSC1|GSC2|GSC3|CJX1|CJX2|CJX4|NXC|NXRC|NDC1|BJ2|HC1|CCZ38|CZ28)[- ]?(\\d+)",
          "table": {
            "09": "9", "12": "12", "18": "18", "22": "22", "25": "25", "32": "32",
            "38": "38", "40": "40", "50": "50", "63": "63", "65": "65", "80": "80",
            "85": "85", "100": "100", "115": "115", "120": "120", "140": "140",
            "170": "170", "225": "225", "265": "265", "1000": "1000", "1250": "1250",
            "1600": "1600", "2400": "2400", "6021": "60",
            "0910": "9", "0911": "9", "1210": "12", "1810": "18", "3210": "32",
            "4011": "40", "5011": "50", "8011": "80", "2511": "25", "3811": "38"
          }
        }
      ]
    }
  ]
}
