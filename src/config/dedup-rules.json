{
  "meta": {
    "description": "强制查重 / 一物多号清洗 的灵活规则配置。修改此文件即可调整归一化与查重口径，无需改代码。",
    "signatureLogic": "同一小类内，signature = normalize(名称) + '|' + normalize(型号规格) + 关键特征 token；signature 相同的不同 FNUMBER 即「疑似一物多号」候选。",
    "fuzzyLogic": "近重：对名称+规格做 token 集合 Jaccard 相似度，>= fuzzyThreshold 且不同 FNUMBER 计入近重候选。"
  },
  "normalize": {
    "lowercase": true,
    "fullwidthToHalf": true,
    "removeSpaces": true,
    "unifySeparators": [
      "/",
      "\\",
      "*",
      "×",
      "x",
      "X",
      "－",
      "—",
      "，",
      "、",
      "；",
      ";"
    ],
    "separatorTo": "/",
    "stripBracketsContent": false
  },
  "defaultAttrs": [
    "FNAME",
    "FSPECIFICATION"
  ],
  "defaultTokens": [
    "型号",
    "直径",
    "螺纹",
    "长度",
    "颜色",
    "材质"
  ],
  "fuzzyThreshold": 0.8,
  "heuristics": [
    {
      "match": [
        "平垫"
      ],
      "attrs": [
        "FSPECIFICATION"
      ],
      "tokens": [
        "型号",
        "螺纹",
        "材质",
        "表面处理",
        "标准"
      ]
    },
    {
