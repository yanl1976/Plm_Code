      "fields": [
        {
          "key": "型号",
          "desc": "厂家附件型号",
          "example": "F11"
        },
        {
          "key": "附件类型",
          "desc": "辅助触头 / 分励脱扣器 / 欠电压脱扣器 / 电动操作机构",
          "example": "辅助触头"
        },
        {
          "key": "适用壳架",
