  "subs": {
    "100101": {
      "subName": "固定式框架断路器",
      "source": "GB/T 14048.2《低压开关设备和控制设备 第2部分：断路器》",
      "nameRule": "写「固定式框架断路器」；「框架」与「万能式」同义，但安装方式必须写清（固定式 / 抽出式分属不同小类）",
      "nameAliases": [
        "框架",
        "万能式断路器",
        "ACB",
        "空气断路器"
      ],
      "specPattern": "{型号} {壳架}/{额定电流}A {分断能力} {极数} {额定电压}",
      "fields": [
        {
          "key": "型号",
          "desc": "厂家型号",
          "example": "CDW3-2000"
        },
        {
          "key": "壳架电流",
          "desc": "630/800/1000/1250/1600/2000/2500/3200/4000/5000/6300A",
          "example": "2000"
        },
        {
          "key": "额定电流",
          "desc": "In，须 ≤ 壳架电流",
          "example": "1600A"
        },
        {
          "key": "分断能力",
          "desc": "Icu/Ics，单位 kA",
          "example": "65/50kA"
        },
        {
          "key": "极数",
          "desc": "3P / 4P",
          "example": "3P"
        },
        {
          "key": "额定电压",
          "desc": "Ue",
          "example": "400V"
        }
      ],
      "example": "CDW3-2000 2000/1600A 65/50kA 3P 400V",
      "avoid": "CDW3-1600（缺壳架、分断、极数、电压，无法核对）"
    },
