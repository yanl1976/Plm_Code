    "100105": {
      "subName": "微型断路器",
      "source": "GB/T 10963.1《电气附件 家用及类似场所用过电流保护断路器》",
      "nameRule": "统一写「微型断路器」；不写「断路器」「小型断路器」「空开」「微断」",
      "nameAliases": [
        "断路器",
        "小型断路器",
        "空开",
        "微断",
        "空气开关"
      ],
      "specPattern": "{型号} {极数} {脱扣特性}{额定电流}A {分断能力} {额定电压}",
      "fields": [
        {
          "key": "型号",
          "desc": "厂家型号，首段含壳架等级",
          "example": "NB8-40J"
        },
        {
          "key": "极数",
          "desc": "1P / 2P / 3P / 4P",
          "example": "3P"
        },
        {
          "key": "脱扣特性+额定电流",
          "desc": "B(3~5In) C(5~10In) D(10~20In) + In",
          "example": "C16"
        },
        {
          "key": "分断能力",
          "desc": "Icn，单位 kA",
          "example": "6kA"
        },
        {
          "key": "额定电压",
          "desc": "Ue，单位 V",
          "example": "230/400V"
        }
      ],
      "example": "NB8-40J 3P C16 6kA 230/400V",
      "avoid": "3P C16 断路器（名称重复、缺分断与电压）"
    },
    "100106": {
      "subName": "漏电断路器",
      "source": "GB/T 16916.1《家用和类似用途的不带过电流保护的剩余电流动作断路器》／GB/T 16917.1《带过电流保护的剩余电流动作断路器》",
      "nameRule": "写「漏电断路器」；带过载保护写「漏电保护断路器（RCBO）」，仅漏电保护写「剩余电流动作断路器（RCCB）」，不写「漏保」「空开带漏电」",
      "nameAliases": [
        "漏保",
        "漏电开关",
        "RCBO",
        "RCCB",
        "剩余电流断路器"
      ],
      "specPattern": "{型号} {极数} {额定电流}A {IΔn} {分断能力} {额定电压}",
      "fields": [
        {
          "key": "型号",
          "desc": "厂家型号",
          "example": "NXBLE-63"
        },
        {
          "key": "极数",
          "desc": "1P+N / 3P+N / 4P",
          "example": "3P+N"
        },
        {
          "key": "额定电流",
          "desc": "In，单位 A",
          "example": "40A"
        },
        {
          "key": "IΔn",
          "desc": "额定剩余动作电流，30mA 防触电 / 100~300mA 防火",
          "example": "30mA"
        },
        {
          "key": "分断能力",
          "desc": "Icn 或 Inc，单位 kA",
          "example": "6kA"
        },
        {
          "key": "额定电压",
          "desc": "Ue",
          "example": "400V"
        }
      ],
      "example": "NXBLE-63 3P+N C40 30mA 6kA 400V",
      "avoid": "NXBLE-63 40A（缺 IΔn ——漏电断路器最关键的参数）"
    },
    "100107": {
      "subName": "断路器附件",
      "source": "GB/T 14048.5《低压开关设备和控制设备 第5-1部分：控制电路电器和开关元件 机电式控制电路电器》（辅助触头等）",
      "nameRule": "按附件类型写具体名：辅助触头 / 分励脱扣器 / 欠电压脱扣器 / 电动操作机构；不写「附件」「配件」",
