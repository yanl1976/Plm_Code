{
  "version": "v16",
  "_comment": "型号规格「特征参数」提取规则库。结合 dedup-rules.json 的 heuristics[].tokens（某小类提取哪些参数）使用。每个参数给出取值正则，按头部企业（施耐德/西门子/ABB/正泰/德力西/魏德米勒/菲尼克斯/宝胜/亨通…）在 ERP 中的真实命名方式归纳。修改无需改代码。单位保留原则：可变单位(电压V/KV、功率W/kW、阻值Ω/KΩ/MΩ、容值μF/pF/nF/mF、电感μH/mH、长度mm/厘米、精度级/±%)用捕获组原样保留；固定单位(直径/间距/截面mm²、芯数芯、位数位、电抗率%)用 suffix 回填。注意避免误捕获：容值/电感量不含裸F/H(防型号后缀)、长度不含裸m/M(防M线圈码)、精度%必须带±(防Uk%=电抗率)；芯数/截面的*数字结构须前有分隔符边界(防M6*35螺钉)。【版本纪律】任何正则改动必须：version+1 → npm run validate 全绿 → --accept 固化新基线并快照旧规则。",
  "decoderFill": false,
  "order": [
    "型号",
    "额定电压",
    "额定电流",
    "极数",
    "频率",
    "等级",
    "脱扣器",
    "分断等级",
    "分断能力",
    "脱扣曲线",
    "线圈电压",
    "变比",
    "精度",
    "结构形式",
    "功率",
    "阻值",
    "容值",
    "电感量",
    "电抗率",
    "电压范围",
    "电流范围",
    "量程",
    "截面",
    "芯数",
    "直径",
    "长度",
    "尺寸(宽*深*高)",
    "螺纹",
    "位数",
    "间距",
    "头型",
    "表面处理",
    "材质",
    "颜色",
    "标准",
    "绝缘等级",
    "品牌",
    "结构形式/指示方式"
  ],
  "defaultExtra": [
    "订货号",
    "其它"
  ],
  "library": {
    "型号": {
      "patterns": [
        "__MODEL__"
      ]
    },
    "频率": {
      "unit": "Hz",
      "join": "",
      "patterns": [
        "(\\d+\\s*[Hh]z)"
      ]
    },
    "额定电压": {
      "unit": "V",
      "join": "/",
      "patterns": [
        "(?:^|[-+\\s/（）），、；;()\\u4e00-\\u9fff\\u2265])((?:(?:AC/?DC|DC/?AC|AC|DC)?\\s*\\d+\\.?\\d*\\s*[-~/]\\s*\\d+\\.?\\d*\\s*(?:KV|V)(?:\\s*(?:AC|DC))?(?![A-Za-z])))",
        "Ue\\s*[=:]\\s*((?:(?:AC/?DC|DC/?AC|AC|DC)?\\s*\\d+\\.?\\d*\\s*(?:KV|V)(?:\\s*(?:AC|DC))?(?![A-Za-z]))",
        "(?:^|[-+\\s/（）），、；;()\\u4e00-\\u9fff\\u2265])((?:(?:AC/?DC|DC/?AC|AC|DC)?\\s*\\d+\\.?\\d*\\s*(?:KV|V)(?:\\s*(?:AC|DC))?(?![A-Za-z])))",
        "(?:BH|LMZ|LMZ1|LMK|LMY|HL|CH|SDH|LZZB|LDZB|LMZB)[\\D]{0,3}(\\d+\\.?\\d*)",
        "(\\d{2,4}/\\d{2,4}(?![A-Za-z*]))"
      ]
    },
    "额定电流": {
      "firstOnly": true,
      "patterns": [
        "(?:^|[\\s/\\u4e00-\\u9fff\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])(\\d+\\.?\\d*\\s*[-~]\\s*\\d+\\.?\\d*A)\\b",
        "In[=:\\s]+(\\d+\\.?\\d*)\\s*(?:KA|MA|A)",
        "Iu[=:\\s]+(\\d+\\.?\\d*)\\s*(?:KA|MA|A)",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])C\\s*(\\d+\\.?\\d*A?)(?![A-Za-z0-9])",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])C\\s*(6|10|16|20|25|32|40|50|63|80|100|125)A?(?![A-Za-z0-9])",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])D\\s*(\\d+\\.?\\d*A?)(?![A-Za-z0-9])",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])D\\s*(6|10|16|20|25|32|40|50|63|80|100|125)A?(?![A-Za-z0-9])",
        "(?:^|[\\s/\\u4e00-\\u9fff\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])(\\d+\\.?\\d*A)(?![A-Za-z0-9])",
        "(?<=[1-4]P-?)(\\d+\\.?\\d*A)"
      ]
    },
    "极数": {
      "patterns": [
        "([单双三四]极)",
        "(\\d+\\s*极)",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])(\\dP|[1-4]P)",
        "(?:^|[\\w./\\-])/([1-4])(?![A-Za-z0-9])"
      ]
    },
    "分断能力": {
      "patterns": [
        "Icu\\s*[=:]\\s*(\\d+\\.?\\d*)\\s*k?a",
        "Ics\\s*[=:]\\s*(\\d+\\.?\\d*)\\s*k?a",
        "Icw\\s*[=:]\\s*(\\d+\\.?\\d*)\\s*k?a",
        "(\\d+\\.?\\d*)\\s*kA\\b"
      ]
    },
    "脱扣器": {
      "patterns": [
        "((?:MA|TMF?|TMD|MIC|ETU|PR|STR|EA|iTR|El|LSI[G]?|LS\\/I)\\d*[A-Za-z0-9.\\-]*)"
      ]
    },
    "脱扣曲线": {
      "patterns": [
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()/])([ABCD])\\s*(?:100|125|10|16|20|25|32|40|50|63|80|6)",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()/])([ABCD])\\s*\\d+\\.?\\d*A\\b"
      ]
    },
    "线圈电压": {
      "firstOnly": true,
      "patterns": [
        "线圈电压\\s*((?:AC|DC)?\\s*\\d+\\.?\\d*\\s*[AV])",
        "工作电压[\\u4e00-\\u9fff]*\\s*((?:AC|DC)?\\s*\\d+\\.?\\d*\\s*V)",
        "触头容量\\s*\\d+\\s*[AV]\\s*(?:AC|DC)?\\s*((?:AC|DC)?\\s*\\d+\\.?\\d*\\s*[AV])",
        "(?:COIL|TENSION)\\s*((?:AC|DC)?\\s*\\d+\\.?\\d*\\s*V)",
        "(?:^|[-+\\s/（）），、；;()])((?:(?:AC/?DC|DC/?AC|AC|DC)?\\s*(?:6|12|24|36|48|60|100|110|127|200|220|230|240|380|400|415|440|500|660|690)\\s*[-~/]\\s*(?:6|12|24|36|48|60|100|110|127|200|220|230|240|380|400|415|440|500|660|690)\\s*V?(?:\\s*(?:AC|DC))?))\\b",
        "(?:^|[-+\\s/（）），、；;()])((?:(?:AC/?DC|DC/?AC|AC|DC)?\\s*(?:6|12|24|36|48|60|100|110|127|200|220|230|240|380|400|415|440|500|660|690)\\s*V(?:\\s*(?:AC|DC))?))\\b"
      ]
    },
    "芯数": {
      "join": "+",
      "patterns": [
        "(\\d+)\\s*芯",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])(\\d+)\\s*[\\*×xX]\\s*\\d+"
      ]
    },
    "截面": {
      "join": "+",
      "normalizeUnit": true,
      "patterns": [
        "(?<!-)(?:UT|MC|SAKAP|GMSTBVA|ST|UK|JH1A|JH|SAK|RSP|VF|WDU|ZDU|JXB|UKN|DT|TBH|JF|CL|TBC|TD|TB|DI|SI|AB|AI|DF|HQ)\\s*[-]?\\s*(\\d+\\.?\\d*\\s*(?:mm²|mm2|mm|²|平方\\s*(?:mm|MM|²)?|MM\\^2|MM\\^|㎜2|MM\\s*2|\\^2\\s*mm?|²\\s*mm?)?)",
        "(?:^|[\\s/+\\-\\uFF08\\uFF09\\uFF0C\\u3001\\uFF1B;()])\\d+\\s*[*×xX]\\s*(\\d+\\.?\\d*\\s*(?:mm²|mm2|mm|²|平方\\s*(?:mm|MM|²)?|MM\\^2|MM\\^|㎜2|MM\\s*2|\\^2\\s*mm?|²\\s*mm?)?)",
        "(?<![\\^])(\\d+\\.?\\d*\\s*(?:mm²|mm2|mm|²\\s*m*|平方|MM\\^2|MM\\^|㎜2|MM\\s*2|\\^2\\s*m*|²\\s*m*))(?![A-Za-z])"
      ]
    },
    "材质": {
      "patterns": [
        "(铜|铝|钢|不锈钢|PVC|PE|ABS|铸铁|合金|黄铜|锌|橡胶|硅|H62|T2Y|TMY|紫铜|LSZH|XLPE|交联|低烟无卤|WDZ|NH)"
      ]
    },
    "功率": {
      "unit": "W",
      "patterns": [
        "(\\d+\\s*/\\s*\\d+\\s*W)",
        "(\\d+\\.?\\d*\\s*(?:KW|kW|W)(?![A-Za-z0-9]))",
        "P\\s*[=:]\\s*(\\d+\\.?\\d*\\s*(?:KW|kW|W)(?![A-Za-z0-9]))"
      ]
    },
    "阻值": {
      "unit": "Ω",
      "patterns": [
        "(\\d+\\.?\\d*\\s*(?:MΩ|KΩ|Ω|OHM|K\\b))"
      ]
    },
    "容值": {
      "unit": "F",
      "patterns": [
        "(\\d+\\.?\\d*\\s*(?:μF|uF|UF|pF|nF|mF))"
      ]
    },
    "电感量": {
      "unit": "H",
      "patterns": [
        "(\\d+\\.?\\d*\\s*(?:μH|uH|UH|mH|MH))"
      ]
    },
    "精度": {
      "patterns": [
        "(\\d+\\.?\\d*\\s*级)",
        "([±]\\s*\\d+\\.?\\d*\\s*%)",
        "精度\\s*(\\d+\\.?\\d*\\s*%)",
        "误差\\s*(\\d+\\.?\\d*\\s*%)",
        "(\\d+\\.?\\d*%)(?<![=U])",
        "0\\.2(?!\\d)S?",
        "0\\.5(?!\\d)S?",
        "(?:5|10)P\\d+"
      ]
    },
    "变比": {
      "patterns": [
        "((?:\\d+\\.?\\d*)\\s*A?)\\s*[/：:]\\s*((?:\\d+\\.?\\d*)\\s*A?)"
      ]
    },
    "结构形式": {
      "patterns": [
        "(?:^|[\\s\\/\\-*])(\\d{2,4}(?:\\s*[*×]\\s*\\d{2,4})?\\s*(?:[\\u2160-\\u2163]+|I+V?))(?=$|[\\s（(])"
      ]
    },
    "螺纹": {
      "patterns": [
        "\\b(M\\s*\\d+\\.?\\d*)"
      ]
    },
    "长度": {
      "unit": "mm",
      "patterns": [
        "(\\d+\\.?\\d*\\s*(?:MM|mm|CM|cm|米))"
      ]
    },
    "直径": {
      "patterns": [
        "[Φ￠ф]\\s*(\\d+\\.?\\d*)",
        "直[径]\\s*(\\d+\\.?\\d*)",
        "外[径]\\s*(\\d+\\.?\\d*)",
        "内[径]\\s*(\\d+\\.?\\d*)"
      ]
    },
    "尺寸(宽*深*高)": {
      "patterns": [
        "(\\d+\\.?\\d*)\\s*[×xX*]\\s*(\\d+\\.?\\d*)\\s*[×xX*]\\s*(\\d+\\.?\\d*)"
      ]
    },
    "颜色": {
      "patterns": [
        "(黄绿|双色|红|绿|蓝|黄|白|黑|橙|灰|紫|棕|粉|透明|浅蓝|深蓝|深灰|军绿)"
      ]
    },
    "头型": {
      "patterns": [
        "(六角|内六角|沉头|盘头|一字|十字|圆头|外六角|平头)"
      ]
    },
    "表面处理": {
      "patterns": [
        "(镀锌|镀镍|氧化|喷塑|发黑|达克罗|钝化|抛光|镀铬|白锌|彩锌)"
      ]
    },
    "标准": {
      "patterns": [
        "(GB\\s*\\d+|IEC|UL|CE|JB\\s*\\d+)"
      ]
    },
    "间距": {
      "patterns": [
        "(\\d+\\.?\\d*)\\s*(?:MM|mm)",
        "ST-?(\\d+\\.?\\d*)"
      ]
    },
    "位数": {
      "patterns": [
        "(\\d+)\\s*位",
        "(?:[/-])\\s*(\\d+)\\s*-?ST\\b"
      ]
    },
    "电抗率": {
      "patterns": [
        "Uk\\s*=\\s*(\\d+\\.?\\d*%)"
      ]
    },
    "结构形式/指示方式": {
      "patterns": [
        "(?:^|[\\s（(\\/-])([Pp]\\d?[KkCc]?|[Mm]2?[KkCc]?|[Ll][KkCc]?)(?=$|[\\s（(\\/-])"
      ]
    },
    "分断等级": {
      "patterns": []
    }
  }
}
