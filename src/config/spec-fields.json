        "输[出]\\s*(?:电压)?\\s*[:：]?\\s*(?:AC|DC)?\\s*(\\d+(?:\\.\\d+)?V)",
        "\\bOUT\\s*[:：]?\\s*(?:AC|DC)?\\s*(\\d+(?:\\.\\d+)?V)"
      ],
      "note": "输出侧电压（可含范围，如 0-10V）"
    },
    "输出电流": {
      "firstOnly": true,
      "patterns": [
        "输[出]\\s*(?:电流)?\\s*[:：]?\\s*(\\d+(?:\\.\\d+)?\\s*[-~]\\s*\\d+(?:\\.\\d+)?mA)",
        "输[出]\\s*(?:电流)?\\s*[:：]?\\s*(\\d+(?:\\.\\d+)?mA)",
        "输[出]\\s*(?:电流)?\\s*[:：]?\\s*(\\d+(?:\\.\\d+)?A)"
      ],
      "note": "输出电流（4-20mA 等）"
    },
    "额定容量": {
      "firstOnly": true,
      "patterns": [
        "(\\d+(?:\\.\\d+)?\\s*(?:kVA|KVA|kVar|kVAR|MVA))",
        "(\\d+(?:\\.\\d+)?\\s*VA\\b)"
      ],
      "note": "变压器/电抗器额定容量。GB 1094.1：容量以 VA / kVA / MVA 表示（小容量用 VA）"
    },
    "厚度": {
      "firstOnly": true,
