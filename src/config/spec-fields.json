      "note": "额定绝缘电压/工频耐受电压。GB/T 14048.1 第 7.2 节"
    },
    "输入量程": {
      "firstOnly": true,
      "patterns": [
        "(?:输入|量程|测量范围)\\s*[:：]?\\s*(\\d+(?:\\.\\d+)?\\s*[-~]\\s*\\d+(?:\\.\\d+)?\\s*(?:mA|V|A|kPa|MPa|℃))",
